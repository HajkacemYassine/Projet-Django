# Configuration AWS (optionnel - pour SageMaker)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-ml-models-bucket
AWS_SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/SageMakerRole

# Configuration Email (pour les alertes)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Configuration Django
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (si vous utilisez PostgreSQL au lieu de SQLite)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=blood_donation_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
